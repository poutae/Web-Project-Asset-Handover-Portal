# Copy to .env for local development. Never commit .env.
# Windows authentication against a local default SQL Server instance:
ConnectionStrings__Default=Server=localhost;Database=Portal;Trusted_Connection=True;TrustServerCertificate=True
# For a SQL login use: Server=localhost;Database=Portal;User Id=<user>;Password=<password>;TrustServerCertificate=True
Portal__PublicBaseUrl=http://localhost:5173
Portal__MaxUploadMb=25
Deployment__Enabled=false
Storage__Provider=Local
# Required outside Development (PFX files kept outside the repository):
# Oidc__SigningCertificatePath=
# Oidc__SigningCertificatePassword=
# Oidc__EncryptionCertificatePath=
# Oidc__EncryptionCertificatePassword=
